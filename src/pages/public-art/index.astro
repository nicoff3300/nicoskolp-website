---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import publicArtData from '../../data/public-art.json';
import type { Project } from '../../types';

const projects = publicArtData as Project[];
---

<BaseLayout
  lang="it"
  title="Public Art - Nico Skolp | Murales e Arte Urbana in Puglia e Italia"
  description="Portfolio completo dei murales monumentali e interventi di arte urbana realizzati da Nico Skolp in Puglia, Basilicata, in tutta Italia ed Europa."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20">
    <!-- Header Sezione Public Art -->
    <header class="text-center mb-12 sm:mb-16 md:mb-20">
      <h1 class="font-druk font-bold text-3xl sm:text-4xl md:text-5xl uppercase tracking-wider text-black">
        Public Art
      </h1>
      <p class="font-sans text-base sm:text-lg text-neutral-600 mt-4 max-w-2xl mx-auto">
        Here, my Urban Art Portfolio. Shape and colors make me fill better.
      </p>
    </header>

    <!-- Griglia Progetti a 2 Colonne -->
    <section aria-label="Elenco progetti Public Art">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        {projects.map((project, index) => (
          <ProjectCard
            project={project}
            eager={index < 2}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
