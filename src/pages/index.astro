---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import siteConfig from '../data/site.json';
import heroArtworks from '../data/hero.json';
---

<BaseLayout title="Nico Skolp - Urban Art, Graffiti & Muralism">
  <!-- Sezione Hero -->
  <section class="pt-16 pb-12 sm:pt-20 sm:pb-16 md:pt-24 md:pb-20 text-center px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="font-druk font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-wider text-black leading-tight sm:leading-snug">
        {siteConfig.tagline}
      </h1>
      <p class="font-sans text-base sm:text-lg md:text-xl text-neutral-600 mt-4 sm:mt-6 font-light">
        {siteConfig.subtagline}
      </p>
      <div class="mt-8 sm:mt-10">
        <a
          href="/digitalart"
          class="no-underline inline-block font-druk font-bold text-sm tracking-wider uppercase px-6 py-3 border border-black hover:bg-black hover:text-white transition-colors"
        >
          Buy NFTS
        </a>
      </div>
    </div>
  </section>

  <!-- Vetrina Opere (Hero Showcase - 13 opere da hero.json) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-28" aria-label="Opere in evidenza">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-8">
      {heroArtworks.map((artwork, index) => (
        <div class="relative w-full aspect-square bg-[#fcfcfc] border border-[#e2e2e2] overflow-hidden flex items-center justify-center p-6">
          <img
            src={artwork.image}
            alt={artwork.title}
            loading={index < 4 ? "eager" : "lazy"}
            fetchpriority={index < 2 ? "high" : "auto"}
            decoding="async"
            width="1080"
            height="1350"
            class="w-full h-full object-contain"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- Sezione Contatto -->
  <section class="py-16 sm:py-24 border-t border-brand-gray-light bg-white px-4 sm:px-6 lg:px-8" id="contatti">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-druk-wide font-bold text-xl sm:text-2xl md:text-3xl text-center uppercase tracking-wider text-black mb-10 sm:mb-12">
        Scrivimi per maggiori informazioni
      </h2>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
