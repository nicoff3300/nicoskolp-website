---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import siteConfig from '../data/site.json';
import heroArtworks from '../data/hero.json';
---

<BaseLayout title="Nico Skolp - Urban Art, Graffiti & Muralism">
  <!-- Sezione Hero -->
  <section class="pt-16 pb-12 sm:pt-20 sm:pb-16 md:pt-24 md:pb-20 text-center px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="font-druk font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-wider text-black leading-tight sm:leading-snug">
        {siteConfig.tagline}
      </h1>
      <p class="font-sans text-base sm:text-lg md:text-xl text-neutral-600 mt-4 sm:mt-6 font-light">
        {siteConfig.subtagline}
      </p>
      <div class="mt-8 sm:mt-10">
        <a
          href="/digitalart"
          class="no-underline inline-block font-druk font-bold text-sm tracking-wider uppercase px-6 py-3 border border-black hover:bg-black hover:text-white transition-colors"
        >
          Buy NFTS
        </a>
      </div>
    </div>
  </section>

  <!-- Vetrina Opere (Hero Showcase - 13 opere da hero.json) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-28" aria-label="Vetrina opere in evidenza">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-8">
      {heroArtworks.map((artwork, index) => (
        <article class="group relative bg-white border border-[#e2e2e2] overflow-hidden flex flex-col transition-all duration-300 hover:border-black hover:shadow-lg">
          <div class="relative w-full aspect-square bg-[#fcfcfc] overflow-hidden flex items-center justify-center p-6">
            <img
              src={artwork.image}
              alt={artwork.title}
              loading={index < 4 ? "eager" : "lazy"}
              fetchpriority={index < 2 ? "high" : "auto"}
              decoding="async"
              width="1080"
              height="1350"
              class="w-full h-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
            />
            <!-- Visualizzazione overlay del titolo all'hover -->
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-4 pointer-events-none">
              <span class="font-druk font-bold text-white text-center text-xs sm:text-sm uppercase tracking-widest px-3 py-1.5 border border-white/60 bg-black/60 backdrop-blur-xs">
                {artwork.title}
              </span>
            </div>
          </div>
          <!-- Didascalia fissa inferiore -->
          <div class="p-4 bg-white border-t border-[#e2e2e2] flex items-center justify-between gap-2">
            <h2 class="font-druk font-bold text-xs uppercase tracking-wider text-black truncate">
              {artwork.title}
            </h2>
            {artwork.category && (
              <span class="font-sans text-[11px] uppercase tracking-widest text-[#8f8f8f] shrink-0">
                {artwork.category}
              </span>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Sezione Contatto -->
  <section class="py-16 sm:py-24 border-t border-brand-gray-light bg-white px-4 sm:px-6 lg:px-8" id="contatti">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-druk-wide font-bold text-xl sm:text-2xl md:text-3xl text-center uppercase tracking-wider text-black mb-10 sm:mb-12">
        Scrivimi per maggiori informazioni
      </h2>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
