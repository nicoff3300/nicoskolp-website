---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pressData from '../../data/press.json';
import type { PressArticle } from '../../types';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');

// Chronological inverse order: from most recent to oldest (2026 -> 2015)
const articles = [...(pressData as PressArticle[])].sort((a, b) => {
  const dateA = a.dateIso || a.year || '0';
  const dateB = b.dateIso || b.year || '0';
  return dateB.localeCompare(dateA);
});
---

<BaseLayout
  title="Press & Media - Nico Skolp | Urban Art & Contemporary Muralism Press Coverage"
  description="Press coverage, articles and interviews featuring Nico Skolp in international art and design publications: Collater.al, Art Vibes, Finestre sull'Arte, Street Art NYC, and Italian newspapers."
  lang="en"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 space-y-16 sm:space-y-24">
    <!-- Section Header -->
    <header class="text-center max-w-3xl mx-auto">
      <h1 class="font-druk font-bold text-3xl sm:text-4xl md:text-5xl uppercase tracking-wider text-black">
        {t('press.title')}
      </h1>
      <p class="font-sans text-base sm:text-lg text-neutral-600 mt-4 leading-relaxed">
        {t('press.subtitle')}
      </p>
    </header>

    <!-- Chronological Press Coverage Grid (From most recent to oldest) -->
    <section aria-label="Press and Media Coverage" class="space-y-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {articles.map((article) => (
          <article class="bg-[#fcfcfc] border border-[#e2e2e2] p-6 sm:p-8 flex flex-col justify-between hover:border-black transition-colors duration-200 group">
            <div class="space-y-4">
              <div class="flex items-center justify-between text-xs font-sans text-neutral-500 uppercase tracking-wider">
                <div class="flex items-center gap-2">
                  <span class={`inline-block px-2.5 py-1 font-druk text-[10px] tracking-wider uppercase ${article.featured ? 'bg-black text-white' : 'border border-[#e2e2e2] text-black bg-white'}`}>
                    {article.type}
                  </span>
                  {article.featured && (
                    <span class="inline-block px-2 py-0.5 border border-black font-druk text-[9px] tracking-wider uppercase text-black">
                      Featured
                    </span>
                  )}
                </div>
                <span class="font-sans font-medium text-neutral-600">{article.date || article.year}</span>
              </div>

              <div class="font-druk font-bold text-sm tracking-wider uppercase text-neutral-500">
                {article.outlet}
              </div>

              <h2 class="font-druk font-bold text-base sm:text-lg uppercase tracking-wide text-black group-hover:text-neutral-700 transition-colors">
                {article.titleEn || article.title}
              </h2>

              <blockquote class="font-sans text-sm sm:text-base text-neutral-600 italic border-l-2 border-black pl-3.5 leading-relaxed">
                "{article.quoteEn || article.quote}"
              </blockquote>
            </div>

            <div class="pt-6 mt-6 border-t border-[#e2e2e2] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              {(article.city || article.project) && (
                <div class="flex flex-col text-xs text-neutral-500 font-sans uppercase tracking-wider space-y-0.5">
                  {article.city && <span>{article.city}</span>}
                  {article.project && (
                    <span class="text-[11px] text-neutral-400">
                      {article.project}
                    </span>
                  )}
                </div>
              )}
              <div class="flex flex-wrap items-center gap-3 sm:ml-auto">
                {article.secondaryUrl && (
                  <a
                    href={article.secondaryUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="no-underline inline-flex items-center gap-1.5 font-druk font-bold text-xs uppercase tracking-wider text-black hover:underline underline-offset-4 focus:outline-none focus-visible:ring-1 focus-visible:ring-black"
                    aria-label={`${article.secondaryLabelEn || article.secondaryLabel || 'Watch video'}: ${article.titleEn || article.title} (opens in a new tab)`}
                  >
                    <span>{article.secondaryLabelEn || article.secondaryLabel || 'Watch video'}</span>
                    <span aria-hidden="true" class="text-sm transition-transform duration-150 group-hover:translate-x-0.5">&nearr;</span>
                  </a>
                )}
                <a
                  href={article.urlEn || article.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="no-underline inline-flex items-center gap-1.5 font-druk font-bold text-xs uppercase tracking-wider text-black hover:underline underline-offset-4 focus:outline-none focus-visible:ring-1 focus-visible:ring-black"
                  aria-label={`${article.primaryLabelEn || article.primaryLabel || t('press.readArticle')} on ${article.outlet}: ${article.titleEn || article.title} (opens in a new tab)`}
                >
                  <span>{article.primaryLabelEn || article.primaryLabel || t('press.readArticle')}</span>
                  <span aria-hidden="true" class="text-sm transition-transform duration-150 group-hover:translate-x-0.5">&nearr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Press Kit & Media Inquiries Box -->
    <section class="bg-[#fcfcfc] border border-black p-8 sm:p-12 text-center max-w-3xl mx-auto space-y-5" aria-labelledby="press-kit-heading">
      <h2 id="press-kit-heading" class="font-druk font-bold text-xl sm:text-2xl uppercase tracking-wider text-black">
        {t('press.pressKitTitle')}
      </h2>
      <p class="font-sans text-sm sm:text-base text-neutral-600 leading-relaxed max-w-2xl mx-auto">
        {t('press.pressKitDesc')}
      </p>
      <div class="pt-2">
        <a
          href="/en#contact"
          class="no-underline inline-flex items-center justify-center px-8 py-3.5 bg-black text-white font-druk font-bold text-xs uppercase tracking-wider hover:bg-neutral-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-black"
        >
          {t('press.pressKitCta')}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
