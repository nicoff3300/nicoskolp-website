---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import publicArtData from '../../../data/public-art.json';
import type { Project } from '../../../types';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations('en');
const projects = publicArtData as Project[];
---

<BaseLayout
  lang="en"
  title="Public Art - Nico Skolp | Urban Art & Murals Portfolio"
  description="Public Art & Urban Murals Portfolio by Nico Skolp. Large-scale contemporary muralism, geometric abstraction and street interventions across Italy and Europe."
>
  <div class="w-full px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20">
    <!-- Public Art Section Header -->
    <header class="text-center mb-12 sm:mb-16 md:mb-20">
      <h1 class="font-druk font-bold text-3xl sm:text-4xl md:text-5xl uppercase tracking-wider text-black">
        {t('publicArt.title')}
      </h1>
      <p class="font-sans text-base sm:text-lg text-neutral-600 mt-4 max-w-2xl mx-auto">
        {t('publicArt.subtitle')}
      </p>
    </header>

    <!-- Two-Column Projects Grid -->
    <section aria-label="Public Art Projects List">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        {projects.map((project, index) => (
          <ProjectCard
            project={project}
            eager={index < 2}
            lang="en"
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
