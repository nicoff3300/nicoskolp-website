---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectGallery from '../../../components/ProjectGallery.astro';
import Lightbox from '../../../components/Lightbox.astro';
import publicArtData from '../../../data/public-art.json';
import type { Project, LightboxItem } from '../../../types';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const projects = publicArtData as Project[];
  return projects.map((project, index) => {
    const prevProject = index > 0 ? projects[index - 1] : null;
    const nextProject = index < projects.length - 1 ? projects[index + 1] : null;

    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject },
    };
  });
}

interface Props {
  project: Project;
  prevProject: Project | null;
  nextProject: Project | null;
}

const { project, prevProject, nextProject } = Astro.props;
const t = useTranslations('en');

// Full gallery image collection for the project
const galleryImages = (project.galleryImages && project.galleryImages.length > 0)
  ? project.galleryImages
  : [project.coverImage];

// Lightbox full-screen viewer items
const lightboxItems: LightboxItem[] = galleryImages.map((imgUrl, idx) => ({
  id: `${project.slug}-${idx + 1}`,
  title: project.title,
  year: project.year,
  city: project.city,
  image: imgUrl,
  description: project.description,
}));

// Specific VisualArtwork Schema.org for Google Search & Image Search
const visualArtworkSchema = {
  "@type": "VisualArtwork",
  "@id": `https://nicoskolp.com/en/public-art/${project.slug}#artwork`,
  "name": project.title,
  "artMedium": "Mural painting / Acrylic and spray on wall",
  "artform": "Mural, Public Art, Street Art",
  "dateCreated": project.year || undefined,
  "image": new URL(project.coverImage, 'https://nicoskolp.com').href,
  "creator": {
    "@id": "https://nicoskolp.com/#artist"
  },
  "locationCreated": project.city ? {
    "@type": "Place",
    "name": `${project.city}, Italy`
  } : undefined,
  "description": project.description || `${project.title} - Urban mural and public artwork by Nico Skolp in ${project.city || 'Italy'} (${project.year || ''})`
};
---

<BaseLayout
  lang="en"
  title={`${project.title} - Public Art - Nico Skolp`}
  description={project.description || `${project.title} - Public art and contemporary muralism by Nico Skolp in ${project.city || 'Italy'} (${project.year || ''})`}
  image={project.coverImage}
  jsonLd={visualArtworkSchema}
>
  <article class="w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-14">
    <!-- Breadcrumb Link Back to Public Art -->
    <nav class="mb-6 sm:mb-8" aria-label="Breadcrumb">
      <a
        href="/en/public-art"
        class="no-underline inline-flex items-center gap-2 font-druk font-medium text-xs sm:text-sm uppercase tracking-wider text-[#8f8f8f] hover:text-black transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-black"
      >
        <span aria-hidden="true">←</span>
        <span>{t('publicArt.back')}</span>
      </a>
    </nav>

    <!-- Artwork Header: Metadata and Title -->
    <header class="mb-6 sm:mb-10">
      {(project.city || project.year) && (
        <div class="flex items-center gap-2 text-xs sm:text-sm font-sans uppercase tracking-wider text-[#8f8f8f] mb-3">
          {project.city && <span>{project.city}</span>}
          {project.city && project.year && <span aria-hidden="true">•</span>}
          {project.year && <span>{project.year}</span>}
        </div>
      )}
      <h1 class="font-druk font-bold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wider text-black leading-tight">
        {project.title}
      </h1>
      {project.description && (
        <p class="font-sans text-base sm:text-lg leading-relaxed text-neutral-700 mt-4 max-w-3xl">
          {project.description}
        </p>
      )}
    </header>

    <!-- Dynamic Photo Gallery Bento Grid (Wix Style) -->
    <section class="mb-12 sm:mb-16" aria-label={`Photo gallery ${project.title}`}>
      <ProjectGallery
        images={galleryImages}
        title={project.title}
        year={project.year}
        city={project.city}
      />
    </section>

    <!-- Project Prev / Next Navigation -->
    <nav class="border-t border-[#e2e2e2] pt-8 sm:pt-12 mt-12 sm:mt-16" aria-label="Project navigation">
      <div class="flex items-center justify-between gap-4">
        {prevProject ? (
          <a
            href={`/en/public-art/${prevProject.slug}`}
            class="no-underline group flex flex-col items-start text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-black max-w-[45%]"
            rel="prev"
          >
            <span class="font-sans text-xs uppercase tracking-wider text-[#8f8f8f] group-hover:text-black transition-colors flex items-center gap-1.5">
              <span aria-hidden="true">←</span>
              <span>{t('publicArt.prev')}</span>
            </span>
            <span class="font-druk font-bold text-xs sm:text-sm uppercase tracking-wider text-black mt-1 group-hover:underline truncate w-full">
              {prevProject.title}
            </span>
          </a>
        ) : (
          <div class="w-1" aria-hidden="true" />
        )}

        {nextProject ? (
          <a
            href={`/en/public-art/${nextProject.slug}`}
            class="no-underline group flex flex-col items-end text-right focus:outline-none focus-visible:ring-2 focus-visible:ring-black max-w-[45%]"
            rel="next"
          >
            <span class="font-sans text-xs uppercase tracking-wider text-[#8f8f8f] group-hover:text-black transition-colors flex items-center gap-1.5">
              <span>{t('publicArt.next')}</span>
              <span aria-hidden="true">→</span>
            </span>
            <span class="font-druk font-bold text-xs sm:text-sm uppercase tracking-wider text-black mt-1 group-hover:underline truncate w-full">
              {nextProject.title}
            </span>
          </a>
        ) : (
          <div class="w-1" aria-hidden="true" />
        )}
      </div>
    </nav>
  </article>

  <!-- Fullscreen Native Lightbox Modal Viewer -->
  <Lightbox items={lightboxItems} />
</BaseLayout>
