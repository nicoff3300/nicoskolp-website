---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import heroData from '../data/hero.json';
import siteConfig from '../data/site.json';
import type { HeroArtwork, LightboxItem } from '../types';

const allArtworks = heroData as HeroArtwork[];

// Produzioni digitali: serie Skolptura e Canvas
const digitalArtworks = allArtworks.filter(
  (item) => item.category === 'sculpture' || item.category === 'canvas'
);

const lightboxItems: LightboxItem[] = digitalArtworks.map((item) => ({
  id: item.id,
  title: item.title,
  year: 'NFT Edition',
  city: item.category === 'sculpture' ? '3D Sculpture' : 'Digital Canvas',
  image: item.image,
  description: `${item.title} - Contemporary 3D exploration and collectible digital artwork by Nico Skolp.`
}));
---

<BaseLayout
  title="Digital Art - Nico Skolp"
  description="Digital art, NFTs and contemporary visual experiments by Nico Skolp."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20">
    <!-- Header Sezione -->
    <header class="text-center mb-12 sm:mb-16 md:mb-20">
      <h1 class="font-druk font-bold text-3xl sm:text-4xl md:text-5xl uppercase tracking-wider text-black">
        Digital Art
      </h1>
      <p class="font-sans text-base sm:text-lg text-neutral-600 mt-4 max-w-2xl mx-auto">
        Contemporary digital sculptures, 3D explorations and collectible NFTs.
      </p>
    </header>

    <!-- Griglia Responsive Produzioni Digitali (Skolptura & Canvas) -->
    <section aria-label="Galleria Digital Art e NFT">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-8">
        {digitalArtworks.map((artwork, index) => {
          const isLCP = index < 4;
          const categoryLabel = artwork.category === 'sculpture' ? '3D Sculpture' : 'Digital Canvas';

          return (
            <button
              type="button"
              data-lightbox-trigger
              data-lightbox-index={index}
              aria-haspopup="dialog"
              aria-label={`Visualizza ${artwork.title} a schermo intero nel visualizzatore`}
              class="group text-left w-full bg-white border border-[#e2e2e2] overflow-hidden flex flex-col transition-all duration-300 hover:border-black hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-black cursor-pointer"
            >
              <!-- Contenitore immagine con badge e ratio coerente -->
              <span class="relative w-full aspect-square bg-[#fcfcfc] overflow-hidden flex items-center justify-center p-6 block">
                <!-- Badge Digital / NFT -->
                <span class="absolute top-3 left-3 bg-black text-white font-druk font-bold text-[10px] sm:text-xs uppercase tracking-wider px-2.5 py-1 z-10 shadow-xs">
                  Digital / NFT
                </span>

                <img
                  src={artwork.image}
                  alt={artwork.title}
                  loading={isLCP ? 'eager' : 'lazy'}
                  fetchpriority={isLCP ? 'high' : 'auto'}
                  decoding="async"
                  width="1080"
                  height="1350"
                  class="w-full h-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
                />

                <!-- Overlay hover elegante -->
                <span class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-4 pointer-events-none">
                  <span class="font-druk font-bold text-white text-center text-xs sm:text-sm uppercase tracking-widest px-3 py-1.5 border border-white/60 bg-black/60 backdrop-blur-xs">
                    Ingrandisci Opera
                  </span>
                </span>
              </span>

              <!-- Didascalia inferiore: titolo e categoria -->
              <span class="p-4 sm:p-5 bg-white border-t border-[#e2e2e2] flex items-center justify-between gap-2 w-full block">
                <span class="font-druk font-bold text-xs sm:text-sm uppercase tracking-wider text-black truncate block">
                  {artwork.title}
                </span>
                <span class="font-sans text-[11px] uppercase tracking-widest text-[#8f8f8f] shrink-0 block">
                  {categoryLabel}
                </span>
              </span>
            </button>
          );
        })}
      </div>
    </section>

    <!-- Box informativo per collezionisti con CTA e profili ufficiali -->
    <section class="mt-16 sm:mt-24 border border-[#e2e2e2] bg-[#fcfcfc] p-8 sm:p-12 md:p-16" aria-label="Informazioni per collezionisti">
      <div class="max-w-3xl mx-auto text-center">
        <span class="font-druk font-bold text-xs uppercase tracking-widest text-[#8f8f8f] block mb-3">
          NFT & Digital Editions
        </span>
        <h2 class="font-druk font-bold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wider text-black leading-tight">
          Informazioni per Collezionisti
        </h2>
        <p class="font-sans text-base sm:text-lg text-neutral-600 mt-4 sm:mt-6 leading-relaxed">
          Le serie <strong>Skolptura</strong> e <strong>Canvas</strong> fondono la ricerca geometrica del muralismo con il rendering tridimensionale, lo studio volumetrico e la riflessione luminosa. Le opere selezionate sono disponibili come edizioni NFT 1/1 certificate su blockchain o tirature digitali per collezionisti.
        </p>
        <div class="mt-8 sm:mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/#contatti"
            class="no-underline inline-flex items-center justify-center font-druk font-bold text-xs sm:text-sm uppercase tracking-wider px-6 py-3.5 bg-black text-white hover:bg-neutral-800 transition-colors"
          >
            Richiedi Quote NFT
          </a>
          <a
            href="mailto:nicoskolp@gmail.com?subject=Richiesta%20Informazioni%20Digital%20Art%20/%20NFT"
            class="no-underline inline-flex items-center justify-center font-druk font-bold text-xs sm:text-sm uppercase tracking-wider px-6 py-3.5 border border-black text-black hover:bg-black hover:text-white transition-colors"
          >
            Email Diretta
          </a>
          {siteConfig.social.linktree && (
            <a
              href={siteConfig.social.linktree}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Linktree Ufficiale Nico Skolp (si apre in una nuova scheda)"
              class="no-underline inline-flex items-center gap-1.5 font-druk font-bold text-xs sm:text-sm uppercase tracking-wider px-6 py-3.5 border border-[#e2e2e2] text-black hover:border-black transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-black"
            >
              <span>Linktree Ufficiale</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </div>
      </div>
    </section>
  </div>

  <!-- Componente Modale Lightbox ad alta risoluzione -->
  <Lightbox items={lightboxItems} />
</BaseLayout>
