---
import siteData from '../data/site.json';
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const homeHref = currentLang === 'en' ? '/en' : '/';
const publicArtHref = currentLang === 'en' ? '/en/public-art' : '/public-art';
const aboutHref = currentLang === 'en' ? '/en/about-me' : '/about-me';
const graffitiHref = currentLang === 'en' ? '/en/graffiti' : '/graffiti';
const archiveHref = currentLang === 'en' ? '/en/skolp-archive' : '/skolp-archive';

const isActivePublicArt = currentPath === publicArtHref || currentPath.startsWith(`${publicArtHref}/`);
const isActiveAbout = currentPath === aboutHref;
const isActiveGraffiti = currentPath === graffitiHref || currentPath.startsWith(`${graffitiHref}/`);
const isActiveArchive = currentPath === archiveHref;
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-brand-gray-light">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand / Logo Nico Skolp (link to / or /en) -->
    <a
      href={homeHref}
      class="no-underline flex items-center gap-3 text-black group select-none"
      aria-label="Nico Skolp - Home"
    >
      <img
        src="/images/brand/Skolp_logo.png"
        alt="Nico Skolp Logo"
        class="h-7 w-auto object-contain transition-opacity duration-150 group-hover:opacity-75"
        width="118"
        height="35"
        loading="eager"
      />
      <span class="font-druk font-bold text-base sm:text-lg tracking-wider uppercase text-black">
        {siteData.name}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-7 lg:space-x-9" aria-label="Navigazione principale">
      <a
        href={publicArtHref}
        aria-current={isActivePublicArt ? "page" : undefined}
        class:list={[
          "font-druk text-xs lg:text-sm tracking-wider uppercase transition-colors duration-150",
          isActivePublicArt
            ? "font-bold text-black underline underline-offset-4 decoration-2"
            : "font-medium text-black hover:underline underline-offset-4 decoration-2"
        ]}
      >
        {t('nav.publicArt')}
      </a>
      <a
        href={aboutHref}
        aria-current={isActiveAbout ? "page" : undefined}
        class:list={[
          "font-druk text-xs lg:text-sm tracking-wider uppercase transition-colors duration-150",
          isActiveAbout
            ? "font-bold text-black underline underline-offset-4 decoration-2"
            : "font-medium text-black hover:underline underline-offset-4 decoration-2"
        ]}
      >
        {t('nav.about')}
      </a>
      <a
        href={graffitiHref}
        aria-current={isActiveGraffiti ? "page" : undefined}
        class:list={[
          "font-druk text-xs lg:text-sm tracking-wider uppercase transition-colors duration-150",
          isActiveGraffiti
            ? "font-bold text-black underline underline-offset-4 decoration-2"
            : "font-medium text-black hover:underline underline-offset-4 decoration-2"
        ]}
      >
        {t('nav.graffiti')}
      </a>
      <a
        href={siteData.social.linktree}
        target="_blank"
        rel="noopener noreferrer"
        class="font-druk text-xs lg:text-sm tracking-wider uppercase font-medium text-black hover:underline underline-offset-4 decoration-2 transition-colors duration-150"
        aria-label="Linktree Nico Skolp (si apre in una nuova scheda)"
      >
        {t('nav.linktree')}
      </a>
    </nav>

    <!-- Desktop Social Icons & Language Switcher -->
    <div class="hidden md:flex items-center space-x-4 pl-4 border-l border-[#e2e2e2]">
      <a
        href={siteData.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="no-underline text-black hover:opacity-60 transition-opacity p-1"
        aria-label="Instagram Nico Skolp"
      >
        <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a
        href={siteData.social.behance}
        target="_blank"
        rel="noopener noreferrer"
        class="no-underline text-black hover:opacity-60 transition-opacity p-1"
        aria-label="Behance Nico Skolp"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7.74 10.96c.71-.24 1.22-.81 1.22-1.74 0-1.57-1.12-2.22-2.73-2.22H1v10h5.45c1.88 0 3.05-.88 3.05-2.61 0-1.25-.71-1.99-1.76-2.19v-.06c.01 0 0 0 0 0zm-4.32-2.3h2.38c.68 0 1.09.28 1.09.89 0 .63-.42.92-1.13.92H3.42V8.66zm2.64 6.64H3.42v-2.09h2.67c.8 0 1.25.32 1.25 1.03 0 .72-.45 1.06-1.28 1.06zM17.47 9c-2.82 0-4.47 1.94-4.47 4.54 0 2.67 1.63 4.46 4.46 4.46 1.87 0 3.19-.74 3.79-2.22h-1.92c-.37.49-.96.75-1.77.75-1.28 0-2.08-.8-2.14-2.17h5.88c.03-.22.05-.49.05-.75 0-2.48-1.42-4.61-3.88-4.61zm-2.04 3.59c.12-.99.78-1.8 1.99-1.8 1.13 0 1.76.77 1.87 1.8h-3.86zM14.61 7h5.56v1.27h-5.56V7z"/>
        </svg>
      </a>

      <!-- Desktop Language Picker -->
      <LanguagePicker currentLang={currentLang} class="pl-2 border-l border-[#e2e2e2]" />
    </div>

    <!-- Mobile Hamburger & Language Bar -->
    <div class="md:hidden flex items-center gap-3">
      <LanguagePicker currentLang={currentLang} class="text-[11px]" />
      <button
        id="mobile-menu-toggle"
        type="button"
        class="flex flex-col justify-center items-center w-10 h-10 gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-black rounded"
        aria-label="Apri menu principale"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="block w-6 h-0.5 bg-black transition-all duration-200"></span>
        <span class="block w-6 h-0.5 bg-black transition-all duration-200"></span>
        <span class="block w-6 h-0.5 bg-black transition-all duration-200"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop -->
<div
  id="drawer-backdrop"
  class="md:hidden fixed inset-0 bg-black/40 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300 z-50"
  aria-hidden="true"
></div>

<!-- Mobile Drawer Aside -->
<aside
  id="mobile-drawer"
  class="md:hidden fixed top-0 right-0 bottom-0 w-full sm:w-80 max-w-[85vw] bg-white z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between p-6 sm:p-8"
  aria-label="Menu di navigazione mobile"
  aria-modal="true"
  role="dialog"
  aria-hidden="true"
  inert
>
  <div>
    <!-- Drawer Header -->
    <div class="flex items-center justify-between pb-6 border-b border-brand-gray-light">
      <a href={homeHref} class="no-underline flex items-center gap-2 drawer-link" aria-label="Nico Skolp - Home">
        <img src="/images/brand/Skolp_logo.png" alt="Nico Skolp Logo" class="h-6 w-auto object-contain" width="100" height="30" />
        <span class="font-druk font-bold text-sm tracking-wider uppercase text-black">Nico Skolp</span>
      </a>
      <button
        id="drawer-close-btn"
        type="button"
        class="p-2 -mr-2 text-black hover:opacity-60 focus:outline-none rounded"
        aria-label="Chiudi menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer Navigation Links -->
    <nav class="flex flex-col mt-8 space-y-4" aria-label="Navigazione mobile drawer">
      <a
        href={publicArtHref}
        aria-current={isActivePublicArt ? "page" : undefined}
        class:list={[
          "drawer-link font-druk text-lg uppercase tracking-wider py-2 border-b border-brand-gray-light/50 transition-colors",
          isActivePublicArt ? "font-bold text-black underline underline-offset-4 decoration-2" : "font-medium text-black hover:underline"
        ]}
      >
        {t('nav.publicArt')}
      </a>
      <a
        href={aboutHref}
        aria-current={isActiveAbout ? "page" : undefined}
        class:list={[
          "drawer-link font-druk text-lg uppercase tracking-wider py-2 border-b border-brand-gray-light/50 transition-colors",
          isActiveAbout ? "font-bold text-black underline underline-offset-4 decoration-2" : "font-medium text-black hover:underline"
        ]}
      >
        {t('nav.about')}
      </a>
      <a
        href={graffitiHref}
        aria-current={isActiveGraffiti ? "page" : undefined}
        class:list={[
          "drawer-link font-druk text-lg uppercase tracking-wider py-2 border-b border-brand-gray-light/50 transition-colors",
          isActiveGraffiti ? "font-bold text-black underline underline-offset-4 decoration-2" : "font-medium text-black hover:underline"
        ]}
      >
        {t('nav.graffiti')}
      </a>
      <a
        href={siteData.social.linktree}
        target="_blank"
        rel="noopener noreferrer"
        class="drawer-link font-druk text-lg uppercase tracking-wider py-2 border-b border-brand-gray-light/50 font-medium text-black hover:underline transition-colors flex items-center justify-between"
        aria-label="Linktree Nico Skolp (si apre in una nuova scheda)"
      >
        <span>{t('nav.linktree')}</span>
        <span class="text-xs text-neutral-400 font-sans" aria-hidden="true">&nearr;</span>
      </a>
      <a
        href={archiveHref}
        aria-current={isActiveArchive ? "page" : undefined}
        class:list={[
          "drawer-link font-druk text-sm uppercase tracking-wider py-2 border-b border-brand-gray-light/50 text-brand-gray-text transition-colors",
          isActiveArchive ? "font-bold text-black underline underline-offset-4 decoration-2" : "hover:text-black hover:underline"
        ]}
      >
        {t('nav.archive')}
      </a>
    </nav>
  </div>

  <!-- Drawer Bottom: Language Switcher & Social Links -->
  <div class="pt-6 border-t border-brand-gray-light space-y-5">
    <div class="flex items-center justify-between">
      <span class="text-xs uppercase tracking-wider text-brand-gray-text font-sans">
        Lingua / Language
      </span>
      <LanguagePicker currentLang={currentLang} />
    </div>

    <div>
      <div class="text-xs uppercase tracking-wider text-brand-gray-text font-sans mb-3">
        {t('footer.follow')}
      </div>
      <div class="flex items-center space-x-6">
        <a
          href={siteData.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="no-underline flex items-center gap-2 text-xs font-druk font-medium uppercase tracking-wider text-black hover:opacity-60"
          aria-label="Instagram Nico Skolp"
        >
          <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle>
          </svg>
          <span>Instagram</span>
        </a>
        <a
          href={siteData.social.behance}
          target="_blank"
          rel="noopener noreferrer"
          class="no-underline flex items-center gap-2 text-xs font-druk font-medium uppercase tracking-wider text-black hover:opacity-60"
          aria-label="Behance Nico Skolp"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M7.74 10.96c.71-.24 1.22-.81 1.22-1.74 0-1.57-1.12-2.22-2.73-2.22H1v10h5.45c1.88 0 3.05-.88 3.05-2.61 0-1.25-.71-1.99-1.76-2.19v-.06c.01 0 0 0 0 0zm-4.32-2.3h2.38c.68 0 1.09.28 1.09.89 0 .63-.42.92-1.13.92H3.42V8.66zm2.64 6.64H3.42v-2.09h2.67c.8 0 1.25.32 1.25 1.03 0 .72-.45 1.06-1.28 1.06zM17.47 9c-2.82 0-4.47 1.94-4.47 4.54 0 2.67 1.63 4.46 4.46 4.46 1.87 0 3.19-.74 3.79-2.22h-1.92c-.37.49-.96.75-1.77.75-1.28 0-2.08-.8-2.14-2.17h5.88c.03-.22.05-.49.05-.75 0-2.48-1.42-4.61-3.88-4.61zm-2.04 3.59c.12-.99.78-1.8 1.99-1.8 1.13 0 1.76.77 1.87 1.8h-3.86zM14.61 7h5.56v1.27h-5.56V7z"/>
          </svg>
          <span>Behance</span>
        </a>
      </div>
    </div>
  </div>
</aside>

<script>
  function initHeaderDrawer() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('drawer-close-btn');
    const backdrop = document.getElementById('drawer-backdrop');
    const drawer = document.getElementById('mobile-drawer');
    const drawerLinks = document.querySelectorAll('.drawer-link');

    if (!toggleBtn || !drawer || !backdrop) return;
    if (toggleBtn.hasAttribute('data-drawer-ready')) return;
    toggleBtn.setAttribute('data-drawer-ready', 'true');

    const elBtn = toggleBtn;
    const elDrawer = drawer as HTMLElement;
    const elBackdrop = backdrop;

    let isOpen = false;

    function openDrawer() {
      isOpen = true;
      elBtn.setAttribute('aria-expanded', 'true');
      elDrawer.classList.remove('translate-x-full');
      (elDrawer as any).inert = false;
      elDrawer.setAttribute('aria-hidden', 'false');
      elBackdrop.classList.remove('opacity-0', 'pointer-events-none');
      elBackdrop.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
      (closeBtn as HTMLElement)?.focus();
    }

    function closeDrawer() {
      isOpen = false;
      elBtn.setAttribute('aria-expanded', 'false');
      elDrawer.classList.add('translate-x-full');
      (elDrawer as any).inert = true;
      elDrawer.setAttribute('aria-hidden', 'true');
      elBackdrop.classList.add('opacity-0', 'pointer-events-none');
      elBackdrop.classList.remove('opacity-100');
      document.body.style.overflow = '';
      (elBtn as HTMLElement)?.focus();
    }

    toggleBtn.addEventListener('click', () => {
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeDrawer);
    }

    backdrop.addEventListener('click', closeDrawer);

    drawerLinks.forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDrawer();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        closeDrawer();
      }
    });
  }

  // Initialize on load and on Astro view transitions
  initHeaderDrawer();
  document.addEventListener('astro:page-load', initHeaderDrawer);
</script>
